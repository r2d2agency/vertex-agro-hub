# O browser chama o próprio frontend em /api; o servidor do frontend repassa para o backend.
VITE_API_URL=/api
VITE_APP_NAME=Vertex Agro

# Runtime do container frontend: URL interna/pública do backend NestJS.
# Em EasyPanel use o host interno do serviço (ex.: http://vertex-backend:3000)
API_PROXY_TARGET=http://localhost:4000
